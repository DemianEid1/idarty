# Database
DATABASE_URL=postgresql://...
DATABASE_URL_UNPOOLED=postgresql://...

# Isolated test database (optional; never point these at production).
# Both are validated by lib/database-test-guard.ts: must be a direct/unpooled
# Neon endpoint in eu-central-1, and must not resolve to the production endpoint.
#
# MIGRATION_TEST_DATABASE_URL — RESTRICTED application role. Used by the guarded
#   integration/E2E paths. Deliberately has no DDL rights.
# MIGRATION_TEST_MIGRATOR_URL — ELEVATED migration-only role on the SAME isolated
#   endpoint as MIGRATION_TEST_DATABASE_URL. Only used by the migration runner
#   when MIGRATION_TEST_MODE=true. If unset, the runner falls back to
#   MIGRATION_TEST_DATABASE_URL (unchanged behaviour).
# MIGRATION_TEST_DATABASE_URL=postgresql://restricted-role:...@ep-xxxxx.eu-central-1.aws.neon.tech/db
# MIGRATION_TEST_MIGRATOR_URL=postgresql://migrator-role:...@ep-xxxxx.eu-central-1.aws.neon.tech/db

# Better Auth: generate a unique random value of at least 32 characters.
BETTER_AUTH_SECRET=
# Development/test only. Production startup fails if this is true.
SKIP_EMAIL_VERIFICATION=false

# Gmail SMTP (transactional email delivery)
GMAIL_SMTP_USER=demo.eid7@gmail.com
GMAIL_SMTP_APP_PASSWORD=

# Optional canonical auth URL
# BETTER_AUTH_URL=https://idarty.com

# Booking management token lifetime in hours (default: 72)
# BOOKING_MANAGE_TOKEN_TTL_HOURS=72

# Sentry (error tracking)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
